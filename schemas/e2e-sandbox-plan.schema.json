{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Only synthetic replay plans: deterministic offline sandbox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "synthetic"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "steps",
        "claim_complete",
        "oracle",
        "cost_microusd",
        "input_tokens",
        "output_tokens",
        "human_minutes"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^C_[0-9a-f]{12}$"
        },
        "steps": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "claim_complete": {
          "type": "boolean"
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initially_applied",
            "ui_pass",
            "ci_pass",
            "email_delivered"
          ],
          "properties": {
            "initially_applied": {
              "type": "boolean"
            },
            "ui_pass": {
              "type": "boolean"
            },
            "ci_pass": {
              "type": "boolean"
            },
            "email_delivered": {
              "type": "boolean"
            }
          }
        },
        "cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "human_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000000
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target_id",
        "fault",
        "authorized"
      ],
      "properties": {
        "operation": {
          "enum": [
            "POST_NONIDEMPOTENT",
            "POST_IDEMPOTENT",
            "GET_READBACK",
            "UI_CHECK",
            "CI_CHECK"
          ]
        },
        "target_id": {
          "type": "string",
          "pattern": "^P_[0-9a-f]{12}$"
        },
        "fault": {
          "enum": [
            "NONE",
            "TIMEOUT_APPLIED",
            "TIMEOUT_NOT_APPLIED",
            "TIMEOUT_PARTIAL"
          ]
        },
        "authorized": {
          "type": "boolean"
        }
      }
    }
  }
}
