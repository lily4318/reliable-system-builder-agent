{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reliable System Builder: structured offline task event batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "batch_id",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "enum": [
        "synthetic",
        "reviewed_real"
      ]
    },
    "batch_id": {
      "type": "string",
      "pattern": "^B_[0-9a-f]{12}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "case_id",
        "group_id",
        "project_id",
        "task_family",
        "source_kind",
        "operation",
        "result",
        "evidence_type",
        "evidence_sha256",
        "source_commit_sha",
        "occurred_at_utc",
        "write_authorized",
        "http_status"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EV_[0-9a-f]{12}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^C_[0-9a-f]{12}$"
        },
        "group_id": {
          "type": "string",
          "pattern": "^G_[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^P_[0-9a-f]{12}$"
        },
        "task_family": {
          "enum": [
            "github_ci",
            "gas_api",
            "web_qa",
            "database",
            "security",
            "general"
          ]
        },
        "source_kind": {
          "enum": [
            "github_actions",
            "gas",
            "ui",
            "manual",
            "other"
          ]
        },
        "operation": {
          "enum": [
            "GET_INVENTORY",
            "GET_CONTENT",
            "CREATE_VERSION",
            "CREATE_DEPLOYMENT",
            "CODE_PATCH",
            "UI_UAT",
            "READ_DATA",
            "UNKNOWN"
          ]
        },
        "result": {
          "enum": [
            "success",
            "failure",
            "unknown",
            "partial"
          ]
        },
        "evidence_type": {
          "enum": [
            "remote_readback",
            "ui_uat",
            "ci_only",
            "log_only",
            "not_verified"
          ]
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_commit_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "write_authorized": {
          "type": "boolean"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Always discarded, never persisted in review queue"
        }
      }
    }
  }
}
